# ── AI Provider ────────────────────────────────────────────
# Options: gemini | openai | openrouter | nebius | ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=

OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
NEBIUS_API_KEY=
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ── Enrichment APIs ────────────────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLScan_API_KEY=
NVD_API_KEY=
OTX_API_KEY=
THREATFOX_API_KEY=
URLHAUS_API_KEY=
MALWAREBAZAAR_API_KEY=
PULSEDIVE_API_KEY=

# ── MISP Integration ───────────────────────────────────────
MISP_URL=https://your-misp-instance
MISP_KEY=
MISP_VERIFYCERT=False

# ── Telegram (Leak monitoring) ─────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ── Keycloak (optional — default admin/admin) ──────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
