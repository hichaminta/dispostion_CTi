# Secrets & sessions
.env
*.session

# Runtime data (generated by pipeline — don't bake into image)
runs.json
schedules.json
utils/local_tracking.json
utils/local_tracking copy.json

# Large output directories (mounted via volume at runtime)
output_cve_ioc/
output_enrichment/
output_correlation/
reports/cti_bulletins/
leak_data_integration/results/
misp_integration/tracking/

# External Docker stacks (managed separately)
misp-docker/
mongodb-docker/
keylocker/

# Python cache
__pycache__/
*.pyc
*.pyo

# Node modules (rebuilt inside container)
frontend/node_modules/
node_modules/

# Git
.git/
.gitignore

# Dev / editor
.vscode/
.claude/
*.log
