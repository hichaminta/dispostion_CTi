        <mxCell id="g_gen2" value="&lt;i&gt;hérite de&lt;/i&gt;" style="html=1;endArrow=block;endFill=0;strokeColor=#2E86C1;strokeWidth=2;fontColor=#2E86C1;fontSize=9;fontStyle=2;" edge="1" source="g_analyst" target="g_user" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- PACKAGES -->
        <!-- P0 Commun -->
        <mxCell id="g_p0" value="Fonctions de Base (Utilisateur)"
          style="swimlane;fontStyle=1;align=center;startSize=28;fillColor=#E8F8F5;strokeColor=#1ABC9C;fontColor=#117A65;fontSize=11;rounded=1;"
          vertex="1" parent="1">
          <mxGeometry x="225" y="76" width="1030" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="g_p0t" value="• Se connecter (Login)&#xa;• Lancer un pipeline simple&#xa;• Consulter le tableau de bord&#xa;• Consulter les statistiques de base&#xa;• Consulter l&apos;historique des runs"
