@startuml GLOBAL_HIERARCHY
!theme plain
skinparam backgroundColor #F8F9FA
skinparam actorStyle awesome

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  FontColor #2C3E50
  FontStyle bold
  FontSize 12
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2980B9
  FontColor #1A5276
  FontSize 11
}
skinparam package {
  BackgroundColor #EBF5FB
  BorderColor #2980B9
  FontColor #1A5276
  FontStyle bold
  FontSize 12
}
skinparam arrow {
  Color #2C3E50
  FontSize 10
}
skinparam note {
  BackgroundColor #FEF9E7
  BorderColor #D4AC0D
  FontColor #7D6608
}
skinparam titleFontSize 18
skinparam titleFontColor #1A5276
skinparam titleFontStyle bold

title BlueSec CTI — Vue Globale : Hiérarchie des Acteurs

' ===== ACTEURS =====
actor "Utilisateur" as User #1ABC9C
actor "Administrateur" as Admin #E74C3C
actor "Analyste CTI" as Analyst #2E86C1
actor "Système\n(Scheduler)" as System #8E44AD

' ===== HÉRITAGE =====
Admin    -up-|> User : hérite de
Analyst  -up-|> User : hérite de

' ===== SYSTÈME =====
rectangle "Système BlueSec CTI" {

  package "Fonctions de Base — Utilisateur" #E8F8F5 {
    usecase "Se connecter\n(Login)" as UC_Login
    usecase "Lancer un pipeline simple" as UC_Simple
    usecase "Consulter le tableau de bord" as UC_Dash
    usecase "Consulter les statistiques" as UC_Stats
    usecase "Consulter l'historique" as UC_Hist
  }

  package "Gestion des Accès\n(Admin uniquement)" #FDEDEC {
    usecase "Créer un utilisateur" as UC_CreateUser
    usecase "Modifier un utilisateur" as UC_EditUser
    usecase "Supprimer un utilisateur" as UC_DelUser
    usecase "Consulter la liste des utilisateurs" as UC_ListUsers
    usecase "Réinitialiser le mot de passe" as UC_ResetPwd
    usecase "Activer / Désactiver un compte" as UC_ToggleUser
    usecase "Attribuer un rôle" as UC_AssignRole
    usecase "Gérer les permissions" as UC_Perms
    usecase "Configurer les clés API\n(VT, AbuseIPDB...)" as UC_APIKeys
    usecase "Configurer MISP / Telegram / LLM" as UC_Config
    usecase "Gérer les planifications" as UC_Schedule
  }

  package "Analyse CTI\n(Analyste CTI uniquement)" #EAF2FB {
    usecase "Lancer un pipeline complet\n(toutes sources)" as UC_FullRun
    usecase "Lancer un pipeline ciblé" as UC_TargetRun
    usecase "Stopper un pipeline" as UC_Stop
    usecase "Consulter les IoCs extraits" as UC_IOC
    usecase "Consulter les CVEs identifiées" as UC_CVE
    usecase "Consulter les données enrichies" as UC_Enriched
    usecase "Mapping MITRE ATT&CK" as UC_Mitre
    usecase "Événements corrélés\n(CRITICAL / HIGH / MEDIUM)" as UC_Corr
    usecase "Filtrer / Rechercher événements" as UC_Filter
    usecase "Gérer les canaux Telegram" as UC_TGChannels
    usecase "Consulter les leaks détectés" as UC_Leaks
    usecase "Analyser un fichier CSV/Excel\n(IA / LLM)" as UC_CSV
    usecase "Générer un bulletin PDF" as UC_Bulletin
    usecase "Exporter en STIX 2.1" as UC_STIX
    usecase "Pousser vers MISP" as UC_MISP
  }

  package "Monitoring & Tableau de Bord\n(Admin + Analyste CTI)" #F9F3FF {
    usecase "Statistiques globales" as UC_GlobalStats
    usecase "Heatmap MITRE ATT&CK" as UC_Heatmap
    usecase "Géolocalisation des menaces" as UC_Geo
    usecase "Logs temps réel (WebSocket)" as UC_Logs
    usecase "Stopper un pipeline en cours" as UC_StopAdmin
  }
}

' ===== ASSOCIATIONS UTILISATEUR =====
User --> UC_Login
User --> UC_Simple
User --> UC_Dash
User --> UC_Stats
User --> UC_Hist

' ===== ASSOCIATIONS ADMIN =====
Admin --> UC_CreateUser
Admin --> UC_EditUser
Admin --> UC_DelUser
Admin --> UC_ListUsers
Admin --> UC_ResetPwd
Admin --> UC_ToggleUser
Admin --> UC_AssignRole
Admin --> UC_Perms
Admin --> UC_APIKeys
Admin --> UC_Config
Admin --> UC_Schedule
Admin --> UC_GlobalStats
Admin --> UC_Logs
Admin --> UC_StopAdmin

' ===== ASSOCIATIONS ANALYSTE =====
Analyst --> UC_FullRun
Analyst --> UC_TargetRun
Analyst --> UC_Stop
Analyst --> UC_IOC
Analyst --> UC_CVE
Analyst --> UC_Enriched
Analyst --> UC_Mitre
Analyst --> UC_Corr
Analyst --> UC_TGChannels
Analyst --> UC_Leaks
Analyst --> UC_CSV
Analyst --> UC_Bulletin
Analyst --> UC_STIX
Analyst --> UC_MISP
Analyst --> UC_GlobalStats
Analyst --> UC_Heatmap
Analyst --> UC_Geo
Analyst --> UC_Logs

' ===== ASSOCIATIONS SYSTÈME =====
System --> UC_FullRun : <<déclenche>>

' ===== INCLUDE =====
UC_CreateUser  .> UC_Login     : <<include>>
UC_FullRun     .> UC_Login     : <<include>>
UC_APIKeys     .> UC_Login     : <<include>>
UC_AssignRole  .> UC_ListUsers : <<include>>
UC_AssignRole  .> UC_Perms     : <<include>>
UC_FullRun     .> UC_Logs      : <<include>>
UC_Corr        .> UC_Filter    : <<include>>

' ===== EXTEND =====
UC_Login       .> UC_ResetPwd  : <<extend>>
UC_Simple      .> UC_FullRun   : <<extend>>
UC_Corr        .> UC_STIX      : <<extend>>
UC_Corr        .> UC_MISP      : <<extend>>
UC_Leaks       .> UC_Bulletin  : <<extend>>
UC_Mitre       .> UC_Heatmap   : <<extend>>

note bottom of Admin
  **Généralisation :**
  Admin hérite de Utilisateur.
  Il dispose de toutes les fonctions
  de base + gestion des accès,
  rôles et configuration système.
end note

note bottom of Analyst
  **Généralisation :**
  Analyste CTI hérite de Utilisateur.
  Il accède à l'analyse CTI complète :
  IoC, CVE, Leaks, STIX, MISP.
end note

@enduml


