title BlueSec — Cas d'Utilisation : Administrateur\n(hérite de Utilisateur)

' ===== ACTEURS =====
actor "Utilisateur" as User   #1ABC9C
actor "Administrateur" as Admin #E74C3C

' Héritage
Admin -up-|> User : hérite de

rectangle "Système BlueSec CTI" {

  ' ---- Fonctions de base (Utilisateur) ----
  package "Fonctions de Base — Utilisateur" #E8F8F5 {
    usecase "Se connecter (Login)" as UC_Login
    usecase "Lancer un pipeline simple" as UC_Simple
    usecase "Consulter le tableau de bord" as UC_Dash
    usecase "Consulter les statistiques" as UC_Stats
    usecase "Consulter l'historique" as UC_Hist
  }

  ' ---- Gestion Utilisateurs ----
  package "Gestion des Utilisateurs" #FDEDEC {
    usecase "Créer un utilisateur" as UC_CreateUser
    usecase "Modifier un utilisateur" as UC_EditUser
    usecase "Supprimer un utilisateur" as UC_DelUser
    usecase "Consulter la liste\ndes utilisateurs" as UC_ListUsers
    usecase "Réinitialiser le\nmot de passe" as UC_ResetPwd
    usecase "Activer / Désactiver\nun compte" as UC_ToggleUser
  }

  ' ---- Gestion Rôles ----
  package "Gestion des Rôles & Permissions" #FDEDEC {
    usecase "Créer un rôle" as UC_CreateRole
    usecase "Attribuer un rôle\nà un utilisateur" as UC_AssignRole
    usecase "Modifier les permissions\nd'un rôle" as UC_EditRole
    usecase "Supprimer un rôle" as UC_DelRole
    usecase "Consulter les rôles" as UC_ListRoles
  }

  ' ---- Configuration ----
  package "Configuration du Système" #FEF9E7 {
    usecase "Configurer les clés API\n(VT, AbuseIPDB, OTX...)" as UC_APIKeys
    usecase "Configurer l'intégration MISP" as UC_MISPConf
    usecase "Configurer les credentials\nTelegram" as UC_TGConf
    usecase "Choisir le fournisseur LLM\n(Gemini / OpenAI / Ollama)" as UC_LLMConf
    usecase "Configurer les sources CTI" as UC_SrcConf
  }

  ' ---- Planification ----
  package "Gestion des Planifications" #EBF5FB {
    usecase "Créer une planification" as UC_CreateSched
    usecase "Modifier une planification" as UC_EditSched
    usecase "Supprimer une planification" as UC_DelSched
    usecase "Activer / Désactiver" as UC_ToggleSched
  }

  ' ---- Supervision ----
  package "Supervision & Monitoring" #F9F3FF {
    usecase "Consulter les statistiques\nglobales" as UC_GlobalStats
    usecase "Consulter les logs\nd'exécution" as UC_Logs
    usecase "Stopper un pipeline\nen cours" as UC_StopPipeline
    usecase "Consulter l'historique\ndes runs" as UC_RunHistory
  }
}

' ===== ASSOCIATIONS UTILISATEUR =====
User --> UC_Login
User --> UC_Simple
User --> UC_Dash
User --> UC_Stats
User --> UC_Hist

' ===== ASSOCIATIONS ADMIN =====
Admin --> UC_CreateUser
Admin --> UC_EditUser
Admin --> UC_DelUser
Admin --> UC_ListUsers
Admin --> UC_ResetPwd
Admin --> UC_ToggleUser

Admin --> UC_CreateRole
Admin --> UC_AssignRole
Admin --> UC_EditRole
Admin --> UC_DelRole
Admin --> UC_ListRoles

Admin --> UC_APIKeys
Admin --> UC_MISPConf
Admin --> UC_TGConf
Admin --> UC_LLMConf
Admin --> UC_SrcConf

Admin --> UC_CreateSched
Admin --> UC_EditSched
Admin --> UC_DelSched
Admin --> UC_ToggleSched

Admin --> UC_GlobalStats
Admin --> UC_Logs
Admin --> UC_StopPipeline
Admin --> UC_RunHistory

' ===== INCLUDE =====
UC_CreateUser .> UC_Login     : <<include>>
UC_APIKeys    .> UC_Login     : <<include>>
UC_AssignRole .> UC_ListUsers : <<include>>
UC_AssignRole .> UC_ListRoles : <<include>>
UC_DelUser    .> UC_ListUsers : <<include>>
UC_EditUser   .> UC_ListUsers : <<include>>

' ===== EXTEND =====
UC_Login      .> UC_ResetPwd  : <<extend>>
UC_CreateUser .> UC_AssignRole : <<extend>>
UC_Simple     .> UC_GlobalStats : <<extend>>

note right of Admin
  **Admin hérite de Utilisateur.**
  Accès complet :
  - Fonctions de base (Login, pipeline simple...)
  - Gestion des comptes et rôles
  - Configuration des intégrations
  - Supervision et monitoring
end note

@enduml


