skinparam titleFontColor #1D8348
skinparam titleFontStyle bold

title BlueSec — Cas d'Utilisation : Analyste CTI\n(hérite de Utilisateur)

' ===== ACTEURS =====
actor "Utilisateur" as User    #1ABC9C
actor "Analyste CTI" as Analyst #2E86C1
actor "Système\n(Scheduler)" as System #8E44AD

' Héritage
Analyst -up-|> User : hérite de

rectangle "Système BlueSec CTI" {

  ' ---- Fonctions de base ----
  package "Fonctions de Base — Utilisateur" #E8F8F5 {
    usecase "Se connecter (Login)" as UC_Login
    usecase "Lancer un pipeline simple" as UC_Simple
    usecase "Consulter le tableau de bord" as UC_Dash
    usecase "Consulter les statistiques" as UC_Stats
    usecase "Consulter l'historique" as UC_Hist
  }

  ' ---- Pipeline ----
  package "Exécution Pipeline CTI" {
    usecase "Lancer un pipeline complet\n(toutes sources)" as UC_FullRun
    usecase "Lancer un pipeline ciblé\n(source unique)" as UC_TargetRun
    usecase "Exécuter une étape\nspécifique" as UC_StepRun
    usecase "Stopper un pipeline" as UC_Stop
    usecase "Visualiser les logs\ntemps réel" as UC_Logs
  }

  ' ---- Résultats ----
  package "Analyse des Résultats CTI" {
    usecase "Consulter les IoCs extraits\n(IP, domaine, hash, URL)" as UC_IOC
    usecase "Consulter les CVEs\nidentifiées" as UC_CVE
    usecase "Consulter les données\nenrichies (VT, géoloc)" as UC_Enriched
    usecase "Mapping MITRE ATT&CK" as UC_Mitre
    usecase "Événements corrélés\n(CRITICAL / HIGH / MEDIUM)" as UC_Corr
    usecase "Filtrer / Rechercher\nles événements" as UC_Filter
  }

  ' ---- Leaks ----
  package "Intelligence Leaks (Telegram)" {
    usecase "Gérer les canaux Telegram" as UC_TGChannels
    usecase "Consulter les leaks\ndétectés" as UC_Leaks
    usecase "Voir les détails d'un leak\n(acteur, données exposées)" as UC_LeakDetail
    usecase "Analyser un fichier\nCSV / Excel (LLM)" as UC_CSV
    usecase "Générer un bulletin\nPDF par leak" as UC_Bulletin
  }

  ' ---- Export ----
  package "Export & Intégration" {
    usecase "Exporter en STIX 2.1" as UC_STIX
    usecase "Pousser vers MISP" as UC_MISP
    usecase "Générer un rapport\nPDF global" as UC_Report
  }

  ' ---- Planification ----
  package "Planification Automatique" {
    usecase "Créer une planification\nautomatique" as UC_CreateSched
    usecase "Activer / Désactiver\nune planification" as UC_ToggleSched
  }

  ' ---- Dashboard ----
  package "Tableau de Bord & Statistiques" {
    usecase "Statistiques globales\nde la plateforme" as UC_GlobalStats
    usecase "Heatmap MITRE ATT&CK" as UC_Heatmap
    usecase "Géolocalisation\ndes menaces" as UC_Geo
  }
}

' ===== ASSOCIATIONS UTILISATEUR =====
User --> UC_Login
User --> UC_Simple
User --> UC_Dash
User --> UC_Stats
User --> UC_Hist

' ===== ASSOCIATIONS ANALYSTE =====
