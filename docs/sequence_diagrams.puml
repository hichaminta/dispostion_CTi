@startuml SEQ_ADMIN_CREATE_USER
!theme plain
skinparam backgroundColor #1a1a2e
skinparam sequenceArrowColor #e94560
skinparam sequenceLifeLineBorderColor #e94560
skinparam sequenceLifeLineBackgroundColor #0f3460
skinparam participantBackgroundColor #0f3460
skinparam participantBorderColor #e94560
skinparam participantFontColor #ffffff
skinparam actorBackgroundColor #e94560
skinparam actorBorderColor #c1121f
skinparam actorFontColor #ffffff
skinparam noteBackgroundColor #16213e
skinparam noteBorderColor #e94560
skinparam noteFontColor #e0e0e0
skinparam sequenceGroupBackgroundColor #16213e
skinparam sequenceGroupBorderColor #e94560
skinparam titleFontColor #e94560
skinparam titleFontSize 16

title Séquence 1 — Admin : Créer un utilisateur et attribuer un rôle

actor "Administrateur" as Admin
participant "Frontend\n(React Dashboard)" as UI
participant "Backend\n(FastAPI)" as API
participant "Auth Module\n(Users DB)" as Auth
participant "Roles Module\n(Roles DB)" as Roles
database "JSON Database\n(users.json)" as DB

== Authentification Admin ==
Admin -> UI : Se connecter (login + mot de passe)
UI -> API : POST /auth/login {email, password}
API -> Auth : Vérifier les credentials
Auth -> DB : SELECT user WHERE email=?
DB --> Auth : Retourner l'utilisateur
Auth --> API : Token JWT généré
API --> UI : { access_token, role: "admin" }
UI --> Admin : Tableau de bord Admin affiché

== Créer un nouvel utilisateur ==
Admin -> UI : Accéder à "Gestion Utilisateurs"
UI -> API : GET /admin/users
API -> DB : Lire users.json
DB --> API : Liste des utilisateurs
API --> UI : [{ id, nom, email, role, actif }]
UI --> Admin : Afficher la liste des utilisateurs

Admin -> UI : Cliquer "Créer un utilisateur"
UI --> Admin : Afficher le formulaire de création

Admin -> UI : Remplir (nom, email, password, rôle)
UI -> UI : Validation côté client (format email, MDP fort)

alt Validation OK
  UI -> API : POST /admin/users { nom, email, password, role_id }
  API -> Auth : Hasher le mot de passe (bcrypt)
  Auth --> API : password_hash
  API -> DB : Insérer nouveau user { id, nom, email, hash, role_id, actif: true }
  DB --> API : { user_id: "usr_123" }
  API --> UI : { success: true, user_id: "usr_123" }
  UI --> Admin : Notification "Utilisateur créé avec succès"
else Validation KO (email déjà utilisé)
  API --> UI : { error: "Email déjà enregistré" }
  UI --> Admin : Message d'erreur affiché
end

== Attribuer / Modifier un rôle ==
Admin -> UI : Sélectionner l'utilisateur créé
UI -> API : GET /admin/roles
API -> Roles : Lire roles.json
Roles --> API : [{ id, nom, permissions[] }]
API --> UI : Liste des rôles disponibles
UI --> Admin : Menu déroulant des rôles

Admin -> UI : Sélectionner le rôle "cti_analyst"
UI -> API : PUT /admin/users/usr_123/role { role_id: "cti_analyst" }
API -> DB : UPDATE user SET role_id = "cti_analyst" WHERE id = "usr_123"
DB --> API : OK
API --> UI : { success: true }
UI --> Admin : Notification "Rôle attribué avec succès"

note over Admin, DB
  L'utilisateur peut maintenant se connecter
  avec les permissions du rôle "cti_analyst"
end note

@enduml


@startuml SEQ_ADMIN_CONFIG_API
!theme plain
skinparam backgroundColor #1a1a2e
skinparam sequenceArrowColor #e94560
skinparam sequenceLifeLineBorderColor #e94560
